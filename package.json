{
  "name": "sms-backend",
  "version": "1.0.0",
  "description": "Student Management & Placement CRM backend",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "check": "node -e \"import('./src/app.js').then(() => console.log('App loaded'))\"",
    "build": "node esbuild.config.js",
    "build:check": "node -e \"import('./dist/lambda.mjs').then(m => console.log('Build OK, exports:', Object.keys(m)))\"",
    "deploy": "npm run build && npx serverless deploy"
  },
  "keywords": [
    "express",
    "postgres",
    "rbac",
    "crm"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1019.0",
    "@aws-sdk/client-ses": "^3.1019.0",
    "@aws-sdk/s3-request-presigner": "^3.1019.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.2",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "pg": "^8.18.0",
    "serverless-http": "^3.2.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "esbuild": "^0.27.4"
  }
}
